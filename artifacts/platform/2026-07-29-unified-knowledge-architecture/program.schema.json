{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mc.plxcustomer.io/schemas/unified-knowledge-program-v1.json",
  "title": "Unified PLX Document and Knowledge Architecture Program",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "title",
    "source_task",
    "accountable_owner",
    "architecture_pattern",
    "status",
    "authority_matrix",
    "department_accountability",
    "invariants",
    "phase_zero_gates",
    "requirements",
    "milestones",
    "tasks",
    "risks",
    "gates",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "plx-unified-knowledge-program/v1"
    },
    "program_id": {
      "const": "PRJ-UNIFIED-KNOWLEDGE"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_task": {
      "const": "TASK-477"
    },
    "accountable_owner": {
      "const": "vince@petrasoap.com"
    },
    "architecture_pattern": {
      "const": "Knowledge Ledger with Disposable Projections"
    },
    "status": {
      "enum": [
        "approved-spec",
        "in-progress",
        "validated",
        "retired"
      ]
    },
    "authority_matrix": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/authority"
      }
    },
    "department_accountability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/departmentAccountability"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/invariant"
      }
    },
    "phase_zero_gates": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/phaseZeroGate"
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 20,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/milestone"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 14,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "risks": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "gates": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "validation": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/validation"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{2,3}$"
    },
    "status": {
      "enum": [
        "blocked",
        "pending",
        "ready",
        "in-progress",
        "passed",
        "failed",
        "complete",
        "deferred"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "departmentAccountability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "accountable_role",
        "decisions",
        "named_owner_status"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "accountable_role": {
          "type": "string",
          "minLength": 1
        },
        "decisions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "named_owner_status": {
          "enum": [
            "confirmed-vince",
            "phase-zero-confirmation-required"
          ]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "authority",
        "canonical_for",
        "projection_policy",
        "authoring_return_path",
        "owner"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "enum": [
            "canonical",
            "workflow-authority",
            "execution-authority",
            "registry-authority",
            "derived"
          ]
        },
        "canonical_for": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "projection_policy": {
          "type": "string",
          "minLength": 1
        },
        "authoring_return_path": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "enforced_by"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "enforced_by": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "phaseZeroGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "owner",
        "status",
        "done_when",
        "blocks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "format": "email"
        },
        "status": {
          "enum": [
            "blocked",
            "pending",
            "passed"
          ]
        },
        "done_when": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "blocks": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "statement",
        "priority",
        "verification"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "category": {
          "enum": [
            "authority",
            "knowledge",
            "ontology",
            "discovery",
            "governance",
            "security",
            "privacy",
            "records",
            "compliance",
            "operations"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "must",
            "should",
            "could"
          ]
        },
        "verification": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "title",
        "owner",
        "status",
        "depends_on",
        "requirements",
        "risks",
        "acceptance_evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "format": "email"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "depends_on": {
          "$ref": "#/$defs/stringArray"
        },
        "requirements": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "risks": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "acceptance_evidence": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "milestone",
        "owner",
        "executor",
        "autonomy",
        "status",
        "depends_on",
        "requirements",
        "repo",
        "done_when"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "milestone": {
          "$ref": "#/$defs/identifier"
        },
        "owner": {
          "type": "string",
          "format": "email"
        },
        "executor": {
          "type": "string",
          "minLength": 1
        },
        "autonomy": {
          "enum": [
            "bounded",
            "human-only"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "depends_on": {
          "$ref": "#/$defs/stringArray"
        },
        "requirements": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "done_when": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "likelihood",
        "impact",
        "owner",
        "mitigation",
        "trigger",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "likelihood": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "impact": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "owner": {
          "type": "string",
          "format": "email"
        },
        "mitigation": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "owner",
        "status",
        "after_milestone",
        "criteria",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "format": "email"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "after_milestone": {
          "$ref": "#/$defs/identifier"
        },
        "criteria": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "evidence": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "asserts"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "asserts": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    }
  }
}
