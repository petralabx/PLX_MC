{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/reconcile",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/sync-subscriptions",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sync-notifications",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/routing-maintenance",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/vendor-spend-refresh",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/github-backfill",
      "schedule": "23 7 * * *"
    },
    {
      "path": "/api/cron/reporting-goals",
      "schedule": "0 10,11 * * 1-5"
    },
    {
      "path": "/api/cron/uat-drift",
      "schedule": "0 10 * * *"
    }
  ],
  "buildCommand": "npm run build"
}
